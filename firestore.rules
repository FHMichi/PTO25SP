rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /calendars/main {
      // Alle Mitstudenten können den Kalender ohne Login lesen.
      allow read: if true;
allow create, update, delete: if request.auth != null
  && request.auth.uid == '2mxuGGxEkoWcoCcpSEJJ8xT0ijz1';
    }
  }
}
